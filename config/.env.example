# ─────────────────────────────────────────────────────────────────────────────
# CarrierFlex-VBCancelBST — Environment Variables
# Copy this file to config/.env and fill in real values.
# config/.env is git-ignored; NEVER commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Azure Service Bus (VB Cancellation trigger) ───────────────────────────────
# Connection string for the Service Bus namespace.
SERVICEBUS_CONNECTION_STRING=Endpoint=sb://your-namespace.servicebus.windows.net/;SharedAccessKeyName=...
# Queue or topic name that publishes PO cancel events.
SERVICEBUS_QUEUE_NAME=po-cancel-events
# Max messages to receive per polling cycle (default: 10).
SERVICEBUS_MAX_MESSAGES=10

# Optional cancellation topic subscription (otherwise queue mode).
SERVICEBUS_TOPIC_NAME=carrier-change
SERVICEBUS_SUBSCRIPTION_NAME=

# Enable milestone CSV consumption only when ready to process BST files.
MILESTONES_SERVICEBUS_ENABLED=false
# Optional dedicated topic/subscription, separate from cancellations.
# Leave blank when FilePublished events arrive on the existing Service Bus receiver.
# A blank connection string reuses SERVICEBUS_CONNECTION_STRING.
MILESTONES_SERVICEBUS_CONNECTION_STRING=
MILESTONES_SERVICEBUS_TOPIC_NAME=
MILESTONES_SERVICEBUS_SUBSCRIPTION_NAME=
MILESTONES_ALLOWED_BLOB_HOSTS=aspdsctinthubarchive.blob.core.windows.net
MILESTONES_ALLOWED_BLOB_CONTAINERS=cfs
MILESTONES_DOWNLOAD_TIMEOUT_MS=60000
MILESTONES_MAX_DOWNLOAD_BYTES=52428800
# ── Databricks (Serve tables — booking details lookup) ────────────────────────
DATABRICKS_HOST=adb-XXXXXXXXXXXXXXXX.XX.azuredatabricks.net
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/your-warehouse-id
# PAT token — if blank, falls back to Azure AD credential chain (az login / SP).
DATABRICKS_TOKEN=

# Azure AD Service Principal for Databricks (used when DATABRICKS_TOKEN is blank).
SP_TENANT_ID=4af8322c-80ee-4819-a9ce-863d5afbea1c
SP_CLIENT_ID=REPLACE-WITH-CLIENT-ID
SP_CLIENT_SECRET=REPLACE-WITH-CLIENT-SECRET
# Set to true during local dev if the SP is not yet provisioned in Databricks.
DATABRICKS_SKIP_SP=false

# ── E2open SFTP (VBKREQ cancel + BST output) ─────────────────────────────────
SFTP_HOST=sftp.e2open.com
SFTP_PORT=22
SFTP_USERNAME=your-e2open-username
# Auth: provide EITHER password OR a private key (file path or inline content).
SFTP_PASSWORD=
SFTP_PRIVATE_KEY_PATH=./config/e2open-key.ppk
SFTP_PRIVATE_KEY_CONTENT=
SFTP_PASSPHRASE=
# Remote path where VBKREQ cancel XML files are deposited.
SFTP_VBKREQ_REMOTE_DIR=/e2open/b2b/scpusers2/e2net/E2NETSTG/e2c0000e9a-3358ade21b-0/in
# Remote path where BST XML files are deposited.
SFTP_BST_REMOTE_DIR=/e2open/b2b/scpusers2/e2net/E2NETSTG/e2c0000e9a-3358ade21b-0/in

# ── Carrier identity (used in BST XML / VBKREQ header) ───────────────────────
# Carrier code matching a carrier-profile.js entry (e.g. DT, Maersk, EVCargo).
CARRIER_CODE=DT

# ── Output / State dirs ───────────────────────────────────────────────────────
OUTPUT_DIR=./output
STATE_DIR=./state
